<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log">

  <!-- optional, add some variables
  https://github.com/nlog/NLog/wiki/Configuration-file#variables
  -->
  <variable name="myvar" value="myvalue"/>

  <!--
  See https://github.com/nlog/nlog/wiki/Configuration-file
  for information on customizing logging rules and outputs.
   -->
  <targets>

    <!--
    add your targets here
    See https://github.com/nlog/NLog/wiki/Targets for possible targets.
    See https://github.com/nlog/NLog/wiki/Layout-Renderers for the possible layout renderers.
    -->

    <!--
    Write events to a file with the date in the filename.
    <target xsi:type="File" name="f" fileName="${basedir}/logs/${shortdate}.log"
            layout="${longdate} ${uppercase:${level}} ${message}" />
    -->
    <target xsi:type="File" name="f" fileName="${basedir}/logs/${shortdate}-${machinename}.log"
      layout="[${longdate}][${uppercase:${level}}][T:${threadid}][${callsite}][${callsite}][Line:${callsite-linenumber:skipFrames=0}] ${message}" />

    <target xsi:type="File" name="f-errors" fileName="${basedir}/logs/${shortdate}-${machinename}-errors.log"
            layout="[${longdate}][${uppercase:${level}}][T:${threadid}][${callsite}][Line:${callsite-linenumber:skipFrames=0}] ${message}" />

    <target xsi:type="File" name="f-fatal" fileName="${basedir}/logs/${shortdate}-${machinename}-fatal.log"
              layout="[${longdate}][${uppercase:${level}}][T:${threadid}][${callsite}][Line:${callsite-linenumber:skipFrames=0}] ${message}" />

    <target xsi:type="File" name="f-info" fileName="${basedir}/logs/${shortdate}-${machinename}-info.log"
            layout="[${longdate}][${uppercase:${level}}][T:${threadid}][${callsite}][Line:${callsite-linenumber:skipFrames=0}] ${message}" />

    <target xsi:type="File" name="f-warn" fileName="${basedir}/logs/${shortdate}-${machinename}-warn.log"
            layout="[${longdate}][${uppercase:${level}}][T:${threadid}][${callsite}][Line:${callsite-linenumber:skipFrames=0}] ${message}" />
  </targets>

  <rules>
    <!-- add your logging rules here -->

    <!--
    Write all events with minimal level of Debug (So Debug, Info, Warn, Error and Fatal, but not Trace)  to "f"
    <logger name="*" minlevel="Debug" writeTo="f" />
    -->
    <logger name="*" minlevel="Info" writeTo="f" />
    <logger name="*" minlevel="Error" maxlevel="Error" writeTo="f-errors" />
    <logger name="*" minlevel="Fatal" maxlevel="Fatal" writeTo="f-fatal" />
    <logger name="*" minlevel="Info" maxlevel="Info" writeTo="f-info" />
    <logger name="*" minlevel="Warn" maxlevel="Warn" writeTo="f-warn" />
  </rules>
</nlog>
